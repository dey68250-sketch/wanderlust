<% layout("/layouts/boilerplate") %>
<body>
  <div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-6">
      <div class="card listing-card shadow-sm">
        <h3 class="card-title mb-3"><%= listing.title %></h3>
        <img
          src="<%= listing.image.url || 'https://via.placeholder.com/600x350?text=No+Image' %>"
          class="card-img-top listing-img"
          alt="<%= listing.title %>"
        />
        <div class="card-body">
          <i>Owned by <%= listing.owner.username %></i>
          <p class="card-text text-muted"><%= listing.description %></p>

          <ul class="list-group list-group-flush my-3">
            <li class="list-group-item">
              <i class="fa-solid fa-indian-rupee-sign me-2"></i>
              <%= listing.price.toLocaleString("en-IN") %> / night
            </li>
            <li class="list-group-item">
              <i class="fa-solid fa-location-dot me-2"></i>
              <%= listing.location %>
            </li>
            <li class="list-group-item">
              <i class="fa-solid fa-globe me-2"></i>
              <%= listing.country %>
            </li>
          </ul>
        <% if (currentUser && listing.owner && currentUser._id.equals(listing.owner._id)) { %>
          <div class="d-flex gap-2 mt-3">
            <a href="/listings/<%= listing._id %>/edit"
              class="btn btn-warning w-100"
            >
              <i class="fa-solid fa-pen-to-square me-1"></i> Edit Listing
            </a>
            <form
              method="POST"
              action="/listings/<%= listing._id %>?_method=DELETE"
              class="w-100"
            >
              <button class="btn btn-danger w-100">
                <i class="fa-solid fa-trash me-1"></i> Delete Listing
              </button>
            </form>
          </div>
        <% } %>

          <hr class="my-4" />

          <!-- Leave a Review -->
          <div class="review-form-section mb-4">
            <h5 class="mb-3"><i class="fa-solid fa-pen me-2"></i>Share your thoughts</h5>
            <form
              action="/listings/<%= listing._id %>/reviews"
              method="POST"
              class="needs-validation p-3 rounded-4"
              novalidate
            >
              <div class="mb-3">
                <label for="rating" class="form-label fw-semibold">Your Rating</label>
                <div class="star-rating">
                  <input type="radio" id="star5" name="review[rating]" value="5" /><label for="star5"><i class="fa-solid fa-star"></i></label>
                  <input type="radio" id="star4" name="review[rating]" value="4" /><label for="star4"><i class="fa-solid fa-star"></i></label>
                  <input type="radio" id="star3" name="review[rating]" value="3" /><label for="star3"><i class="fa-solid fa-star"></i></label>
                  <input type="radio" id="star2" name="review[rating]" value="2" /><label for="star2"><i class="fa-solid fa-star"></i></label>
                  <input type="radio" id="star1" name="review[rating]" value="1" /><label for="star1"><i class="fa-solid fa-star"></i></label>
                </div>
              </div>
              <div class="mb-3">
                <label for="comment" class="form-label fw-semibold">Comment</label>
                <textarea
                  name="review[comment]"
                  id="comment"
                  class="form-control rounded-3"
                  rows="3"
                  placeholder="Tell others about your experience..."
                  required
                ></textarea>
              </div>
              <button class="btn btn-dark rounded-pill px-4" type="submit">
                <i class="fa-solid fa-paper-plane me-1"></i> Submit Review
              </button>
            </form>
          </div>

          <!-- Existing Reviews -->
          <div class="reviews-section">
            <h5 class="mb-3">
              <i class="fa-solid fa-comments me-2"></i>Reviews
              <span class="badge bg-secondary rounded-pill"><%= listing.reviews.length %></span>
            </h5>

            <% if (listing.reviews.length === 0) { %>
              <p class="text-muted fst-italic">No reviews yet. Be the first to share your experience!</p>
            <% } %>

            <div class="d-flex flex-column gap-3">
              <% for (let review of listing.reviews) { %>
                <div class="review-card p-3 rounded-4 shadow-sm">
                  <div class="d-flex justify-content-between align-items-start">
                    <div>
                      <p class="mb-1 fw-semibold">
                        <i class="fa-solid fa-circle-user me-1"></i>
                        <%= review.author ? review.author.username : "Anonymous" %>
                      </p>
                      <div class="review-stars mb-1">
                        <% for (let i = 1; i <= 5; i++) { %>
                          <i class="fa-solid fa-star <%= i <= review.rating ? 'text-warning' : 'text-secondary opacity-25' %>"></i>
                        <% } %>
                      </div>
                      <p class="mb-0"><%= review.comment %></p>
                    </div>
                    <form
                      action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                      method="POST"
                    >
                      <button class="btn btn-sm btn-link text-danger p-0" title="Delete review">
                        <i class="fa-solid fa-trash"></i>
                      </button>
                    </form>
                  </div>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>