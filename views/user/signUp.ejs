<% layout("/layouts/boilerplate") %>
<div class="container">
  <div class="row justify-content-center">
    <div class="col-12 col-sm-8 col-md-6 col-lg-4 mt-5">

      <h2 class="mb-4 text-center">Sign Up</h2>

      <form method="POST" action="/signUp" class="needs-validation" novalidate>
        <div class="mb-3">
          <label for="username" class="form-label">Username</label>
          <input type="text" class="form-control" id="username" name="username" placeholder="Choose a username" autocomplete="off" required>
       </div>

      <div class="mb-3">
        <label for="email" class="form-label">Email address</label>
        <input type="email" class="form-control" id="email" name="email" placeholder="name@example.com" autocomplete="off" required>
      </div>

      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input type="password" class="form-control" id="password" name="password" placeholder="Password" autocomplete="new-password" required>
      </div>

        <button type="submit" class="btn btn-primary w-100">Sign Up</button>
      </form>

    </div>
  </div>
</div>